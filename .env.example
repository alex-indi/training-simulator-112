# Local secrets and machine-specific configuration.
# Copy to .env and never commit real secrets.

WEEEK_API_TOKEN=
MOS_API_KEY=
OPENAI_API_KEY=

# PostgreSQL connection used by FastAPI, SQLAlchemy and Alembic.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/training_simulator_112

# Frontend URL of the local API. Variables prefixed with VITE_ are exposed to the browser.
VITE_API_URL=http://localhost:8000

# Local bind addresses; for LAN set both to 0.0.0.0 and use the server PC IP above.
BACKEND_HOST=127.0.0.1
FRONTEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
