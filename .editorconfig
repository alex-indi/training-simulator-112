root = true

# Общие правила для всех файлов проекта.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Python использует отступы по 4 пробела.
[*.py]
indent_size = 4

# JavaScript, React, JSON, CSS и конфигурационные файлы.
[*.{js,jsx,json,css,scss,yml,yaml}]
indent_size = 2

# TOML.
[*.toml]
indent_size = 2

# Markdown.
# Не удаляем пробелы в конце строк автоматически:
# в Markdown два пробела могут означать перенос строки.
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# PowerShell-скрипты.
[*.ps1]
indent_size = 4

# Shell-скрипты.
[*.sh]
indent_size = 2